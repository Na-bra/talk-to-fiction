PORT=4000

# Deployed client origin, e.g. https://ai-npc-generator.vercel.app
# Leave empty locally to allow any origin.
CLIENT_ORIGIN=

# Supabase — Project URL and API keys, from Project Settings in the dashboard.
SUPABASE_URL=
# Publishable key ("anon" on older projects). Safe to expose.
SUPABASE_PUBLISHABLE_KEY=
# Secret key ("service_role" on older projects). Bypasses Row Level Security.
# Only the test harness uses it — the running API never does.
SUPABASE_SECRET_KEY=

# Google Gemini API key — https://aistudio.google.com/apikey
AI_API_KEY=

# Dialogue model — this one has to hold the character together.
#   gemini-3.5-flash-lite   $0.30 / $2.50  per MTok  (default)
#   gemini-3.5-flash        $1.50 / $9.00  per MTok  (best consistency)
# Note: the 2.5 family is closed to new API keys — it lists, but 404s on use.
AI_MODEL=gemini-3.5-flash-lite

# Model for reflection + summarisation. Structured extraction, not performance.
AI_MODEL_FAST=gemini-3.5-flash-lite

# Run `npm run models` to list what your key can actually reach.
